--// Settings
SettingsTab:CreateToggle({
    Name = "Instant Prompts",
    CurrentValue = false,
    Flag = "InstantPrompts",

    Callback = function(Value)
        if PromptAddedConnection then
            PromptAddedConnection:Disconnect()
            PromptAddedConnection = nil
        end

        for _, v in ipairs(Workspace:GetDescendants()) do
            if v:IsA("ProximityPrompt") then
                if OriginalHoldDurations[v] == nil then
                    OriginalHoldDurations[v] = v.HoldDuration
                end

                v.HoldDuration = Value and 0 or OriginalHoldDurations[v]
            end
        end

        if Value then
            PromptAddedConnection = Workspace.DescendantAdded:Connect(function(v)
                if v:IsA("ProximityPrompt") then
                    OriginalHoldDurations[v] = v.HoldDuration
                    v.HoldDuration = 0
                end
            end)
        end
    end
})

SettingsTab:CreateToggle({
    Name = "Fullbright",
    CurrentValue = false,
    Flag = "Fullbright",

    Callback = function(Value)
        FullbrightEnabled = Value

        if FullbrightConnection then
            FullbrightConnection:Disconnect()
            FullbrightConnection = nil
        end

        if Value then
            -- Save current lighting
            local OldBrightness = Lighting.Brightness
            local OldClockTime = Lighting.ClockTime
            local OldFogEnd = Lighting.FogEnd
            local OldGlobalShadows = Lighting.GlobalShadows
            local OldAmbient = Lighting.Ambient

            local function ApplyFullbright()
                if not FullbrightEnabled then
                    return
                end

                Lighting.Brightness = 1
                Lighting.ClockTime = 12
                Lighting.FogEnd = 786543
                Lighting.GlobalShadows = false
                Lighting.Ambient = Color3.fromRGB(178, 178, 178)
            end

            ApplyFullbright()

            FullbrightConnection = game:GetService("RunService").RenderStepped:Connect(function()
                if FullbrightEnabled then
                    ApplyFullbright()
                end
            end)
            -- Restore when disabled
            task.spawn(function()
                while FullbrightEnabled do
                    task.wait()
                end

                Lighting.Brightness = OldBrightness
                Lighting.ClockTime = OldClockTime
                Lighting.FogEnd = OldFogEnd
                Lighting.GlobalShadows = OldGlobalShadows
                Lighting.Ambient = OldAmbient
            end)
        end
    end
})

